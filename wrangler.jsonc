{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "my-city-twin",
  "compatibility_date": "2026-09-01",

  // The team's Cloudflare account, which owns mycitytwin.com. Stated
  // explicitly because this login can also see a personal account, and
  // wrangler refuses to guess between two.
  "account_id": "78b8f2d4c05c15737956ef91105ed310",

  // Cloudflare issues the certificate and writes the DNS record itself.
  // Both the apex and www, because people type www whether or not anyone
  // advertises it, and a domain that only answers on one of the two looks
  // broken to the person who guessed wrong.
  "routes": [
    { "pattern": "mycitytwin.com", "custom_domain": true },
    { "pattern": "www.mycitytwin.com", "custom_domain": true }
  ],

  // Not the app's build directory but the collection of them: one frozen
  // build per submitted iteration, each addressed at its own path.
  //
  //   releases/ver-1/  →  mycitytwin.com/ver-1/
  //   releases/ver-2/  →  mycitytwin.com/ver-2/
  //
  // A version is built once, committed, and never rebuilt, so that a marker
  // returning to it sees what was submitted. `npm run deploy` re-uploads
  // them all, unchanged.
  "assets": {
    "directory": "./releases",
    // Every sunlight calculation runs in the browser, so the script below is
    // not an application server — it only answers the requests a directory
    // of files cannot: the bare domain, and a deep link inside a version.
    // Anything that matches a file is served without invoking it.
    "binding": "ASSETS"
  },
  "main": "./worker/index.ts",

  "observability": {
    "enabled": true
  }
}
